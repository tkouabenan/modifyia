# Local defaults. Copy to .env.local; never commit real secrets.
# Leave APP_URL blank in a proxied development preview so the request origin is used.
APP_URL=
DATABASE_URL=file:./data/modifyia.db
MEDIA_ROOT=./data/media

# Required in production for OAuth signing. Generate a long random value.
SESSION_SECRET=
REQUIRE_EMAIL_VERIFICATION=true
ADMIN_EMAIL=

# Real motion transfer. Provider-issued KEY_ID:KEY_SECRET; server-side only.
HF_CREDENTIALS=
WORKER_CONCURRENCY=2
GENERATION_TIMEOUT_MINUTES=45
# Optional absolute paths to modern system binaries; otherwise npm binaries are used.
FFMPEG_PATH=
FFPROBE_PATH=

# Upload limits and configurable credit/cost model.
MAX_VIDEO_MB=200
MAX_IMAGE_MB=20
TRIAL_CREDITS=100
CREDITS_PER_SECOND=5
PROVIDER_COST_PER_SECOND_CENTS=40
CREATOR_PRICE_CENTS=2900
CREATOR_MONTHLY_CREDITS=500
PRO_PRICE_CENTS=7900
PRO_MONTHLY_CREDITS=1600

# SMTP verification and password-reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Google OAuth (callback: APP_URL/api/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Private S3-compatible media storage. Leave blank for local development storage.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Stripe monthly USD plans and signed webhook delivery.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Single-host testing only. Production should use PostgreSQL and private shared storage.
ALLOW_LOCAL_PRODUCTION=false
